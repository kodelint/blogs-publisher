{
  "name": "blogs-publisher",
  "version": "1.0.4",
  "description": "A GitHub Action to publish markdown blog posts to Medium, Dev.to, and Hashnode platform",
  "main": "dist/index.js",
  "scripts": {
    "prep": "ts-node scripts/prep.ts",
    "build": "tsc",
    "package": "npm run build && ncc build lib/main.js -o dist --minify --source-map --license licenses.txt",
    "test": "jest",
    "test:coverage": "npx jest --coverage",
    "lint": "eslint src/**/*.ts __tests__/**/*.ts",
    "lint:fix": "eslint src/**/*.ts __tests__/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "size": "bundlesize",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "commit": "git-cz",
    "prepare": "husky install",
    "release": "semantic-release"
  },
  "keywords": [
    "github",
    "blog",
    "actions",
    "automation",
    "publishing",
    "medium",
    "devto",
    "hashnode",
    "markdown"
  ],
  "author": "kodelint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kodelint/blogs-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/kodelint/blogs-publisher/issues"
  },
  "homepage": "https://github.com/kodelint/blogs-publisher#readme",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.1",
    "axios": "^1.11.0",
    "front-matter": "^4.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "semantic-release": "^22.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.2.6",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@types/jest": "^29.5.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.4.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@vercel/ncc": "^0.36.1",
    "awesome-lint": "^1.2.0",
    "bundlesize": "^0.18.2",
    "commitizen": "^4.3.1",
    "complexity-report": "^2.0.0-alpha",
    "coverage-badges-cli": "^1.0.0",
    "cz-conventional-changelog": "^3.0.1",
    "doctoc": "^2.2.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^8.0.3",
    "jest": "^29.6.1",
    "license-checker": "^25.0.1",
    "markdown-it": "^14.1.0",
    "markdown-link-check": "^3.11.2",
    "prettier": "^3.0.0",
    "snyk": "^1.1202.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.1.6"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "bundlesize": [
    {
      "path": "dist/index.js",
      "maxSize": "25000kB"
    },
    {
      "path": "dist/index.js.gz",
      "maxSize": "25000kB"
    }
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md"
  ],
  "release": {
    "branches": [
      "main",
      {
        "name": "develop",
        "prerelease": true
      }
    ],
    "npm": false,
    "repositoryUrl": "https://github.com/kodelint/blogs-publisher",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "npm run package && echo 'Built and packaged for release'"
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "dist/**",
              "label": "Distribution files"
            },
            {
              "path": "action.yml",
              "label": "Action configuration"
            },
            {
              "path": "README.md",
              "label": "Documentation"
            },
            {
              "path": "CHANGELOG.md",
              "label": "Changelog"
            }
          ],
          "successComment": false,
          "failComment": false,
          "failTitle": false,
          "labels": false,
          "releasedLabels": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "package-lock.json",
            "dist/**"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
